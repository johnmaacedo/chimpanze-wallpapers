{
  "name": "chimpanze-wallpapers",
  "productName": "Chimpanzé Wallpapers",
  "version": "1.4.0",
  "description": "Wallpapers por monitor com transições motion, upscaling 4K e edição de imagem estática.",
  "author": "João Victor de Macedo",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev:ui": "vite",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "start": "electron .",
    "dist:win": "vite build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.17.0",
    "lucide-react": "1.49.0",
    "motion": "13.5.0",
    "playwright-core": "1.55.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resedit": "3.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@img/sharp-win32-x64": "0.35.5",
    "@koromix/koffi-win32-x64": "3.3.1",
    "koffi": "3.3.1",
    "sharp": "0.35.5",
    "onnxruntime-node": "1.27.0"
  },
  "build": {
    "appId": "com.chimpanze.wallpapers",
    "productName": "Chimpanzé Wallpapers",
    "executableName": "ChimpanzeWallpapers",
    "copyright": "João Victor de Macedo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/@img/sharp-linux*/**",
      "!node_modules/@img/sharp-libvips-linux*/**",
      "!node_modules/@img/sharp-wasm32/**",
      "!node_modules/@koromix/koffi-linux*/**",
      "!node_modules/koffi/doc/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "./build/afterPack.js",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chimpanzé Wallpapers",
      "artifactName": "Chimpanze-Wallpapers-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}